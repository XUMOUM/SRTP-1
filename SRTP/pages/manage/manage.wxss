.manage-container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 120rpx;
}

/* 顶部标题 */
.manage-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  color: white;
  text-align: center;
}

.manage-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.manage-subtitle {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
  font-weight: 300;
}

/* 添加用药按钮 */
.add-medicine-section {
  padding: 30rpx;
}

.add-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
  width: 100%;
}

.add-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
  font-weight: bold;
}

.add-text {
  font-size: 28rpx;
}

/* 用药列表 */
.medicine-list {
  padding: 0 30rpx;
}

.medicine-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 25rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.medicine-info {
  flex: 1;
  min-width: 0;
}

.medicine-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.pill-icon {
  width: 36rpx;
  height: 36rpx;
  background: #667eea;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 20rpx;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.medicine-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2d3748;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.medicine-details {
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.dosage {
  font-size: 26rpx;
  color: #4a5568;
  font-weight: 500;
}

.instruction {
  font-size: 26rpx;
  color: #718096;
}

.medicine-schedule {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.schedule-time {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
  margin-right: 20rpx;
  background: #ebf4ff;
  padding: 4rpx 16rpx;
  border-radius: 30rpx;
  margin-bottom: 8rpx;
}

.schedule-frequency {
  font-size: 24rpx;
  color: #718096;
  margin-bottom: 8rpx;
}

.medicine-notes {
  background: #f8fafc;
  border-radius: 10rpx;
  padding: 15rpx;
  margin-top: 10rpx;
}

.notes-label {
  font-size: 22rpx;
  color: #4a5568;
  font-weight: 500;
  margin-right: 8rpx;
}

.notes-content {
  font-size: 22rpx;
  color: #718096;
}

.medicine-actions {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.action-btn {
  border: none;
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
  font-size: 22rpx;
  margin-bottom: 10rpx;
  min-width: 100rpx;
  color: white;
}

.action-btn.edit {
  background: #667eea;
}

.action-btn.delete {
  background: #f56565;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 30rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 25rpx;
  opacity: 0.5;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #a0aec0;
  margin-bottom: 15rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #cbd5e0;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
  max-width: 90%;
  max-height: 80vh;
  overflow-y: auto;
}

.medicine-modal {
  width: 750rpx;
}

.modal-header {
  padding: 40rpx 40rpx 20rpx;
  text-align: center;
  border-bottom: 2rpx solid #f1f5f9;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2d3748;
}

.modal-body {
  padding: 30rpx 40rpx;
}

.modal-footer {
  display: flex;
  border-top: 2rpx solid #f1f5f9;
}

.modal-btn {
  flex: 1;
  background: none;
  border: none;
  padding: 30rpx;
  font-size: 28rpx;
  border-radius: 0;
}

.modal-btn.cancel {
  color: #718096;
  border-right: 1rpx solid #f1f5f9;
}

.modal-btn.confirm {
  color: #667eea;
  font-weight: bold;
}

/* 表单样式 - 修复垂直居中 */
.form-group {
  margin-bottom: 30rpx;
  width: 100%;
}

.form-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
  width: 100%;
}

.form-group.half {
  width: 48%;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #4a5568;
  font-weight: 500;
  margin-bottom: 15rpx;
}

/* 修复输入框 - 确保文字垂直居中 */
.form-input {
  width: 100%;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 0 30rpx;  /* 上下内边距改为0，用line-height控制高度 */
  font-size: 28rpx;
  background: #f8fafc;
  box-sizing: border-box;
  height: 90rpx;  /* 固定高度 */
  line-height: 90rpx;  /* 行高等于高度，实现垂直居中 */
  text-align: left;
}

/* 修复选择框 - 确保文字垂直居中 */
.picker-display {
  width: 100%;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 0 30rpx;  /* 上下内边距改为0 */
  font-size: 28rpx;
  background: #f8fafc;
  color: #4a5568;
  box-sizing: border-box;
  height: 90rpx;  /* 固定高度 */
  line-height: 90rpx;  /* 行高等于高度，实现垂直居中 */
  display: block;  /* 从flex改为block */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;  /* 超出显示省略号 */
}

.picker-display.placeholder {
  color: #a0aec0;
}

/* 修复备注输入框 */
.form-textarea {
  width: 100%;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 25rpx 30rpx;
  font-size: 28rpx;
  background: #f8fafc;
  min-height: 150rpx;
  box-sizing: border-box;
  line-height: 1.5;  /* 备注框保持多行 */
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #a0aec0;
  margin-top: 10rpx;
}

.form-hint {
  display: block;
  font-size: 24rpx;
  color: #a0aec0;
  margin-top: 10rpx;
}

.error-input {
  border-color: #f56565 !important;
  background-color: #fff5f5 !important;
}

/* 时间选择器 */
.time-picker-list {
  margin-bottom: 20rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.time-picker-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 15rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.time-label {
  font-size: 26rpx;
  color: #4a5568;
  margin-right: 20rpx;
  min-width: 100rpx;
  flex-shrink: 0;
  line-height: 70rpx;  /* 垂直居中 */
}

.time-picker-item .picker-display {
  flex: 1;
  margin-right: 15rpx;
  height: 70rpx;  /* 稍微小一点 */
  line-height: 70rpx;
  padding: 0 20rpx;
}

.remove-time-btn {
  background: #f56565;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 0 25rpx;
  font-size: 24rpx;
  height: 70rpx;
  line-height: 70rpx;  /* 按钮文字垂直居中 */
  min-width: 100rpx;
  display: inline-block;
  text-align: center;
  flex-shrink: 0;
}

.add-time-btn {
  background: #667eea;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 0;
  font-size: 28rpx;
  width: 100%;
  height: 80rpx;  /* 固定高度 */
  line-height: 80rpx;  /* 垂直居中 */
  margin-top: 10rpx;
  display: block;
  text-align: center;
}

/* 错误提示 */
.error-toast {
  position: fixed;
  top: -100rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #f56565;
  color: white;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(245, 101, 101, 0.3);
  z-index: 10000;
  transition: top 0.3s ease;
}

.error-toast.show {
  top: 100rpx;
}

.error-icon {
  margin-right: 15rpx;
  font-size: 28rpx;
}

.error-message {
  font-size: 26rpx;
  font-weight: 500;
}

/* OCR结果弹窗 */
.ocr-modal {
  width: 700rpx;
  max-height: 80vh;
}

.ocr-result-scroll {
  max-height: 500rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.ocr-result-text {
  font-size: 26rpx;
  color: #2d3748;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

/* beta标签样式 */
.beta-tag {
  font-size: 20rpx;
  color: white;
  background: #f56565;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 10rpx;
  display: inline-block;
}

/* ===== AI解析结果弹窗样式 - 删除模式 ===== */
.parsed-modal {
  width: 680rpx;
  max-height: 80vh;
  border-radius: 24rpx;
  overflow: hidden;
}

/* 标题区 */
.parsed-modal .modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.parsed-modal .modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d3748;
}

.parsed-modal .modal-subtitle {
  font-size: 26rpx;
  color: #667eea;
  background: #edf2ff;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
}

/* 操作提示 */
.action-tip {
  padding: 20rpx 30rpx;
  background: #fef5e7;
  border-bottom: 2rpx solid #e2e8f0;
}

.tip-text {
  font-size: 24rpx;
  color: #b7791f;
}

/* 药品列表 */
.parsed-list {
  max-height: 600rpx;
  padding: 0 20rpx;
}

/* 药品卡片 */
.medicine-card {
  display: flex;
  align-items: center;
  padding: 25rpx;
  margin-bottom: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  border: 2rpx solid #e2e8f0;
  position: relative;
}

/* 左侧序号 */
.card-left {
  margin-right: 20rpx;
}

.card-index {
  width: 48rpx;
  height: 48rpx;
  background: #667eea;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
  font-weight: 600;
}

/* 药品内容 */
.card-content {
  flex: 1;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d3748;
}

.card-frequency {
  font-size: 24rpx;
  color: #667eea;
  background: #edf2ff;
  padding: 4rpx 16rpx;
  border-radius: 30rpx;
}

.card-details {
  font-size: 26rpx;
  color: #4a5568;
  margin-bottom: 8rpx;
}

.card-times {
  font-size: 24rpx;
  color: #718096;
}

/* 右侧删除按钮 */
.card-delete {
  width: 60rpx;
  height: 60rpx;
  background: #f56565;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  cursor: pointer;
  transition: all 0.2s ease;
}

.card-delete:active {
  transform: scale(0.9);
  background: #c53030;
}

.delete-icon {
  color: white;
  font-size: 32rpx;
  font-weight: bold;
}

/* 底部按钮 */
.parsed-modal .modal-footer {
  display: flex;
  border-top: 2rpx solid #f1f5f9;
  padding: 20rpx 30rpx;
}

.parsed-modal .modal-btn {
  flex: 1;
  margin: 0 10rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  border-radius: 50rpx;
}

.parsed-modal .modal-btn.cancel {
  background: #f8fafc;
  color: #4a5568;
  border: 2rpx solid #e2e8f0;
}

.parsed-modal .modal-btn.confirm {
  background: #667eea;
  color: white;
  border: none;
}

.parsed-modal .batch-add-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

/* ===== 按频次分组折叠样式 ===== */
.med-group {
  margin-bottom: 20rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  background: #f8fafc;
  border-bottom: 2rpx solid #f1f5f9;
}

.group-header:active {
  background: #edf2f7;
}

.group-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-header-icon {
  font-size: 36rpx;
}

.group-header-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d3748;
}

.group-header-count {
  font-size: 22rpx;
  color: #a0aec0;
  background: #edf2ff;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
}

.group-header-arrow {
  font-size: 24rpx;
  color: #cbd5e0;
  transition: all 0.2s;
}

.group-items {
  padding: 0;
}

.group-items .medicine-item {
  border-bottom: 2rpx solid #f5f7fa;
  margin-bottom: 0;
  border-radius: 0;
  box-shadow: none;
  padding: 28rpx 30rpx;
}

.group-items .medicine-item:last-child {
  border-bottom: none;
}