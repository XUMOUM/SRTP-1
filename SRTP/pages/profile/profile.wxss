/* ===== 健康摘要卡片 ===== */
.health-summary-card {
  margin: 0 30rpx 20rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border-left: 6rpx solid #48bb78;
}

.health-summary-header {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 2rpx solid #f1f5f9;
  background: #f8fafc;
}

.health-summary-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.health-summary-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3748;
}

.health-summary-arrow {
  font-size: 28rpx;
  color: #cbd5e0;
}

.health-summary-body {
  padding: 20rpx 30rpx;
}

.health-tag-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
  padding: 0;
}

.health-tag-item:last-child {
  margin-bottom: 0;
}

.health-tag-label {
  font-size: 24rpx;
  color: #718096;
  width: 100rpx;
  flex-shrink: 0;
}

.health-tag-value {
  font-size: 24rpx;
  color: #2d3748;
  font-weight: 500;
  flex: 1;
  line-height: 1.6;
}

.health-tag-item.has-data .health-tag-value {
  color: #2d3748;
}

.health-tag-item.no-data .health-tag-value {
  color: #cbd5e0;
  font-weight: normal;
}