.settings-container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 30rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.setting-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.setting-icon {
  width: 60rpx;
  height: 60rpx;
  background: #f1f5f9;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.setting-text {
  font-size: 30rpx;
  color: #2d3748;
  font-weight: 500;
}

.setting-switch {
  transform: scale(0.9);
}

.setting-right {
  display: flex;
  align-items: center;
}

.setting-desc {
  font-size: 26rpx;
  color: #a0aec0;
  margin-right: 15rpx;
}

.setting-arrow {
  font-size: 24rpx;
  color: #cbd5e0;
}

/* 自定义铃声区域 */
.custom-ringtone-section {
  background: white;
  margin: 30rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.section-title {
  font-size: 28rpx;
  color: #718096;
  font-weight: 500;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.custom-ringtone-list {
  padding: 0 30rpx;
}

.custom-ringtone-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.custom-ringtone-item:last-child {
  border-bottom: none;
}

.custom-ringtone-item:active {
  background-color: #f8fafc;
}

.custom-ringtone-item.selected {
  background-color: #edf2ff;
}

.custom-ringtone-left {
  flex: 1;
}

.custom-ringtone-name {
  display: block;
  font-size: 28rpx;
  color: #2d3748;
  margin-bottom: 8rpx;
}

.custom-ringtone-duration {
  font-size: 22rpx;
  color: #a0aec0;
}

.custom-ringtone-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.custom-ringtone-check {
  color: #667eea;
  font-size: 32rpx;
  font-weight: bold;
}

.custom-ringtone-delete {
  color: #f56565;
  font-size: 36rpx;
  font-weight: bold;
  width: 50rpx;
  height: 50rpx;
  text-align: center;
  line-height: 50rpx;
  border-radius: 50%;
  background: #fed7d7;
}

/* 铃声预览区域 */
.preview-section {
  background: white;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-top: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.preview-title {
  font-size: 28rpx;
  color: #4a5568;
  font-weight: 500;
  margin-bottom: 20rpx;
  display: block;
}

.preview-controls {
  display: flex;
  gap: 20rpx;
}

.preview-btn {
  flex: 1;
  background: #667eea;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
}

.preview-btn.playing {
  background: #f56565;
}

/* 铃声选择弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 600rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
}

.ringtone-modal {
  width: 700rpx;
}

.modal-header {
  padding: 40rpx 40rpx 20rpx;
  text-align: center;
  border-bottom: 2rpx solid #f1f5f9;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2d3748;
}

.ringtone-list {
  max-height: 600rpx;
  overflow-y: auto;
  padding: 0;
}

.ringtone-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f1f5f9;
  transition: background-color 0.2s;
}

.ringtone-item:active {
  background-color: #f8fafc;
}

.ringtone-item.selected {
  background-color: #edf2ff;
}

.ringtone-name {
  font-size: 28rpx;
  color: #2d3748;
}

.ringtone-check {
  color: #667eea;
  font-size: 28rpx;
  font-weight: bold;
}

.modal-body {
  padding: 30rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #4a5568;
  line-height: 1.5;
}

.modal-footer {
  display: flex;
  border-top: 2rpx solid #f1f5f9;
}

.modal-btn {
  flex: 1;
  background: none;
  border: none;
  padding: 30rpx;
  font-size: 28rpx;
  border-radius: 0;
}

.modal-btn.cancel {
  color: #718096;
  border-right: 1rpx solid #f1f5f9;
}

.modal-btn.confirm {
  color: #667eea;
  font-weight: bold;
}
/* 引导横幅 */
.guide-banner {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: 20rpx 30rpx;
  padding: 25rpx;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.guide-banner-text {
  color: white;
  font-size: 28rpx;
  font-weight: 500;
}

/* 授权提示 */
.auth-tip {
  background: #fef5e7;
  border-radius: 16rpx;
  padding: 25rpx;
  margin: 0 30rpx 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tip-content {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
  color: #b7791f;
}

.tip-text {
  font-size: 26rpx;
  color: #744210;
}

.auth-btn {
  background: #667eea;
  color: white;
  font-size: 28rpx;
  padding: 16rpx 50rpx;
  border-radius: 50rpx;
  border: none;
  width: auto;
  margin: 0;
}

.auth-btn:active {
  background: #5a67d8;
}

/* 授权成功提示 */
.auth-success {
  background: #c6f6d5;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 0 30rpx 20rpx 30rpx;
}

.success-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
  color: #22543d;
}

.success-text {
  font-size: 26rpx;
  color: #22543d;
  font-weight: 500;
}

/* 通知说明 */
.notification-desc {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 25rpx;
  margin: 0 30rpx 20rpx 30rpx;
  border-left: 6rpx solid #667eea;
}

.desc-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 15rpx;
}

.desc-text {
  display: block;
  font-size: 24rpx;
  color: #718096;
  line-height: 1.6;
  margin-bottom: 8rpx;
}