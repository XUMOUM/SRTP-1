/* ===== 闹钟页面 - 重设计版 ===== */
.alarm-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #1a1f2e 0%, #2a1f3a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  overflow: hidden;
}

/* 动态背景元素 */
.alarm-bg {
  position: absolute;
  width: 100%;
  height: 100%;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(102, 126, 234, 0.2), rgba(118, 75, 162, 0.1));
  filter: blur(60rpx);
  animation: float 20s infinite ease-in-out;
}

.circle1 {
  width: 600rpx;
  height: 600rpx;
  top: -200rpx;
  right: -200rpx;
  background: rgba(102, 126, 234, 0.2);
  animation-delay: 0s;
}

.circle2 {
  width: 800rpx;
  height: 800rpx;
  bottom: -300rpx;
  left: -300rpx;
  background: rgba(118, 75, 162, 0.15);
  animation-delay: 5s;
}

.circle3 {
  width: 400rpx;
  height: 400rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(236, 72, 153, 0.1);
  animation: pulse 3s infinite;
}

/* 主卡片 */
.alarm-card {
  position: relative;
  width: 680rpx;
  max-width: 90%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 60rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 40rpx 80rpx rgba(0, 0, 0, 0.3), 0 0 0 2rpx rgba(255, 255, 255, 0.1) inset;
  z-index: 10;
  animation: cardFloat 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 顶部警示条 */
.alarm-badge {
  background: linear-gradient(90deg, #f97316, #ef4444);
  border-radius: 40rpx;
  padding: 12rpx 30rpx;
  display: inline-block;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 20rpx rgba(239, 68, 68, 0.3);
  animation: badgePulse 2s infinite;
}

.badge-text {
  color: white;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 闹钟图标区域 */
.alarm-icon-wrapper {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 20rpx auto 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.alarm-icon {
  font-size: 140rpx;
  position: relative;
  z-index: 2;
  animation: alarmShake 0.5s infinite;
  filter: drop-shadow(0 20rpx 30rpx rgba(0, 0, 0, 0.2));
}

.icon-ring {
  position: absolute;
  border-radius: 50%;
  border: 4rpx solid rgba(102, 126, 234, 0.3);
  animation: ringExpand 2s infinite;
}

.ring1 {
  width: 100%;
  height: 100%;
  animation-delay: 0s;
}

.ring2 {
  width: 140%;
  height: 140%;
  animation-delay: 0.5s;
  opacity: 0.5;
}

/* 药品名称 */
.medicine-name {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: #1f2937;
  text-align: center;
  margin-bottom: 30rpx;
  line-height: 1.3;
  word-break: break-word;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 药品详情卡片 */
.medicine-detail-card {
  background: #f8fafc;
  border-radius: 40rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid #e2e8f0;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.02);
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #e2e8f0;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
}

.detail-value {
  font-size: 32rpx;
  color: #1f2937;
  font-weight: 600;
}

/* 时间显示 */
.time-display {
  text-align: center;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 30rpx;
  box-shadow: 0 10rpx 20rpx rgba(102, 126, 234, 0.3);
}

.time-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.time-value {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: white;
  letter-spacing: 4rpx;
}

/* 备注信息 */
.notes-box {
  background: #f1f5f9;
  border-radius: 30rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-left: 8rpx solid #f97316;
}

.notes-icon {
  font-size: 32rpx;
}

.notes-text {
  flex: 1;
  font-size: 26rpx;
  color: #334155;
  line-height: 1.5;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 30rpx;
  margin-bottom: 30rpx;
}

.btn-taken, .btn-snooze {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 30rpx 0;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s ease;
  margin: 0;
}

.btn-taken {
  background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
  color: white;
  box-shadow: 0 15rpx 30rpx rgba(72, 187, 120, 0.3);
}

.btn-taken:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.btn-snooze {
  background: #f1f5f9;
  color: #334155;
  border: 2rpx solid #cbd5e0;
}

.btn-snooze:active {
  background: #e2e8f0;
}

.btn-icon {
  font-size: 32rpx;
}

/* 振动提示 */
.vibration-tip {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
}

.vibration-wave {
  width: 8rpx;
  height: 8rpx;
  background: #f97316;
  border-radius: 50%;
  animation: wavePulse 1s infinite;
}

.wave1 { animation-delay: 0s; }
.wave2 { animation-delay: 0.2s; }
.wave3 { animation-delay: 0.4s; }

.tip-text {
  font-size: 24rpx;
  color: #f97316;
  margin-left: 10rpx;
}

/* 动画定义 */
@keyframes float {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  33% { transform: translate(-30rpx, 30rpx) rotate(5deg); }
  66% { transform: translate(30rpx, -20rpx) rotate(-5deg); }
}

@keyframes pulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.1; }
  50% { transform: translate(-50%, -50%) scale(1.5); opacity: 0.2; }
}

@keyframes cardFloat {
  0% { opacity: 0; transform: translateY(100rpx) scale(0.9); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes badgePulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.9; transform: scale(1.02); }
}

@keyframes alarmShake {
  0%, 100% { transform: rotate(0); }
  25% { transform: rotate(-10deg); }
  75% { transform: rotate(10deg); }
}

@keyframes ringExpand {
  0% { transform: scale(0.8); opacity: 0.8; }
  100% { transform: scale(1.5); opacity: 0; }
}

@keyframes wavePulse {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.5); opacity: 1; }
}

/* 确保样式不被覆盖 */
.alarm-container, .alarm-card, .alarm-icon, .medicine-name {
  all: initial;
}

.alarm-container {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  z-index: 10000 !important;
}